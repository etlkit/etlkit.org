# EditorConfig — https://editorconfig.org
# Matches the formatting Prettier already applied upstream, so running
# Prettier (which reads this file) reformats nothing. Keep in sync with it.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 80

# Markdown: trailing spaces are significant (hard line breaks).
[*.md]
trim_trailing_whitespace = false
